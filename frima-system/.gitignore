# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local database files
/data/*.db
/data/*.db-journal
/data/*.db-wal

# Generated Prisma client
/src/generated

# Uploaded media
/data/uploads/

# Downloaded stock photo pool (reproducible via npm run db:fetch-photos).
# Real FRIMA photographs should be committed, or kept with the backups.
/photos/*/
!/photos/README.md

# Generated from brand/frima-logo.svg by npm run brand:logo
/public/brand/
